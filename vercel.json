{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "jelajahtoba-backend": {
      "root": "jelajahtoba-backend",
      "framework": "express",
      "entrypoint": "server.js"
    },
    "jelajahtoba-frontend": {
      "root": "jelajahtoba-frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "jelajahtoba-frontend"
      }
    }
  ]
}
