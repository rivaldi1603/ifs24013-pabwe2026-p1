{
  "name": "jelajahtoba-root",
  "type": "module",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
    "dev:frontend": "bun --cwd jelajahtoba-frontend dev",
    "dev:backend": "bun --cwd jelajahtoba-backend dev",
    "build": "bun --cwd jelajahtoba-frontend build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "sql.js": "^1.15.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
